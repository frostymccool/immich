# Internal URL of the Immich server, no trailing slash, no /api suffix.
IMMICH_URL=http://immich-server:2283

# Personal API key with only the "asset.read" and "asset.update" permission scopes.
IMMICH_API_KEY=

# Shared secret checked against the "x-webhook-secret" header — set this as a custom
# header in the Immich workflow's "Trigger Webhook" step config.
WEBHOOK_SECRET=

PORT=8080
MATCH_WINDOW_MINUTES=60
SWEEP_SCHEDULE=0 3 * * *
SKIP_SWEEP_IF_UPLOADED_WITHIN_MINUTES=30
